    "call generateExamQuiz [{"userId":"00000000-0000-4000-8000-00000000aaaa","isPremium":true,"teachingV2":false,"sourceExcerpt":"[s.1] Mitozda kromozom sayısı korunur.","requireSourceSupport":false,"freeMeter":null,"count":5,"topicLabel":"Hücre Bölünmesi","prepTitle":"YKS Biyoloji","charge":true,"urgent":true,"userPrompt":"Sınav: YKS Biyoloji. Konu: Hücre Bölünmesi. Zorluk: orta. Öğrenci temel bilgilere sahip: tanımları kısa geç, ağırlığı uygulamaya ve problem çözümüne ver. Öğrenci nötr: dengeli ve net bir tonla anlat.  \\nFormül, tanım ve yasa YALNIZCA aşağıdaki kaynak sayfalarının metninde yazıyorsa kullanılır. Kaynak sayfada olmayan, ders kitabından bildiğin formülü içeri alma. Öğretmen notu vurgu ve sıradır; notta geçen bir ifade kaynak sayfada yoksa dersin olgusu olmaz. Çözümlü örnek yalnızca bu düğümün kaynak sayfalarındaki sayı ve formülü kullanır. Sayısal örnekte formül, birimli yerine koyma ve sonuç ayrı yazılır. Birim dönüşümünde iki tarafta farklı birim olsun ve arada işlem olmasın. commonMistake yalnız bu konunun kaynak sayfalarından gelsin: claim öğrencinin yanlış inancı, correction kaynağın doğrusudur. Kaynakta olmayan birimi veya formülü hata diye de yazma.[s.1] Mitozda kromozom sayısı korunur. 5 çoktan seçmeli alıştırma sorusu. Şıklar A/B/C/D gibi net olsun. En az 1 soruda birden fazla doğru şık olsun (multi true, correct dizi)."}]",
    "db update exam_prep_nodes eq(id,"00000000-0000-4000-8000-0000000000b1") payload={"session_meta":{"topicId":"dtn1","topicTitle":"Hücre Bölünmesi","sourcePages":[1,2],"activityMinutes":8}}",
