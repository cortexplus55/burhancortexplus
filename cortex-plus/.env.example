NEXT_PUBLIC_APP_NAME=Cortex Plus
NEXT_PUBLIC_APP_URL=https://cortexplus.app
NEXT_PUBLIC_APP_DOMAIN=cortexplus.app
APP_SECRET=
CRON_SECRET=

NEXT_PUBLIC_SUPABASE_URL=https://dgjfyewgrukglsehyntc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_STANDARD_MODEL=gpt-4o-mini
OPENAI_ADVANCED_MODEL=gpt-4o
# One-shot konu haritası yönlendirmesi (öğrenci görmez)
OPENAI_OUTLINE_STANDARD_MODEL=gpt-4o-mini
OPENAI_OUTLINE_STRONG_MODEL=gpt-4.1
# gpt-4.1 art arda düşerse yedek (öğrenci görmez)
OPENAI_OUTLINE_FALLBACK_MODEL=gpt-4.1-mini

# Adaptive Learning decision provider (server-only; never NEXT_PUBLIC_)
# auto: Jev when JEV_ENABLED + credential; otherwise OpenAI is intentional primary.
# openai: never call Jev. jev: prefer Jev; missing key still starts the app.
DECISION_PROVIDER=auto
# Access path: auto | typesafe | gateway (unknown → auto)
# auto picks TYPESAFE_API_KEY → AI_GATEWAY_API_KEY → Vercel OIDC.
JEV_ACCESS=auto
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional overrides (test/proxy). Defaults:
#   typesafe base https://api.typesafe.ai model jev-1.13.0
#   gateway base  https://ai-gateway.vercel.sh/typesafe model typesafe-ai/jev
JEV_BASE_URL=
JEV_MODEL=
# Explicit opt-in. Absent/false keeps OpenAI primary. Default false.
JEV_ENABLED=false
# Shadow: OpenAI decides for student; Jev runs after() for audit only.
JEV_SHADOW_MODE=false
JEV_TIMEOUT_MS=2000
JEV_MIN_CONFIDENCE=0.45
JEV_FALLBACK_ENABLED=true

PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
PAYTR_NO_INSTALLMENT=0
PAYTR_MAX_INSTALLMENT=0

# Google Workspace SMTP (uygulama şifresi — Resend yok)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cortexplus@cortexplus.app
SMTP_PASS=
EMAIL_FROM=Cortex Plus <cortexplus@cortexplus.app>
# Kurulum: docs/delivery/WORKSPACE-EMAIL.md — operasyon: cortexplus@cortexplus.app

# Search Console HTML tag doğrulama (meta); GSC → HTML etiketi → content değeri
GOOGLE_SITE_VERIFICATION=

# İstek sınırı sayacı (Upstash Redis).
#
# Üretimde bunları ELLE DOLDURMAYIN: Vercel'in Upstash entegrasyonu bağlıysa
# aynı bilgiyi KV_REST_API_URL / KV_REST_API_TOKEN adıyla kendisi enjekte
# ediyor ve kod ikisini de tanıyor. İki yerde iki kopya tutmak, anahtar
# yenilendiğinde birinin unutulacağı bir tuzak olur.
#
# Buradakiler yalnızca yerel geliştirmede kendi Redis'inizi bağlamak için.
# Boşsa sayaç bellekte tutulur — yerelde doğru çalışır, üretimde çalışmaz.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Hata takibi (Sentry) — boş bırakılırsa Sentry hiç başlamaz,
# uygulama bugünküyle birebir aynı çalışır.
# Zorunlu olan tek satır: sentry.io > Settings > Client Keys sayfasındaki DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Aşağıdaki üçü isteğe bağlı: hata izinin sıkıştırılmış değil, gerçek
# dosya adı ve satır numarasıyla görünmesini sağlar.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Playwright authenticated E2E (tests/e2e/auth.setup.ts). Commit'e gerçek değer yazma.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
