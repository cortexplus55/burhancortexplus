{
  "name": "cortex-plus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:jev-live": "vitest run tests/unit/adaptive-jev-live.test.ts",
    "test:db": "node scripts/test-reschedule-transaction.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "e2e:seed": "node scripts/seed-e2e-users.mjs",
    "e2e:login": "node scripts/e2e-login.mjs",
    "design:measure": "node scripts/design/measure-screens.mjs",
    "design:audit": "node scripts/design-audit.mjs",
    "test:visual": "node scripts/visual-baseline.mjs run",
    "test:visual:update": "node scripts/visual-baseline.mjs update",
    "perf:measure": "node scripts/perf-measure.mjs",
    "perf:compare": "node scripts/perf-compare.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@napi-rs/canvas": "^1.0.9",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/oidc": "^4.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^13.4.0",
    "gsap": "^3.15.0",
    "heic-convert": "^2.1.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "next": "^15.5.24",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "openai": "^7.5.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "posthog-js": "^1.418.17",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
