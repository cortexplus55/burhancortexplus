{
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cortexplus.app" }],
      "destination": "https://cortexplus.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subscription-renewal",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/lifecycle-notifications",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/founder-health-check",
      "schedule": "*/15 * * * *"
    }
  ]
}
