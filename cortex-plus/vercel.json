{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.cortexplus.app" }],
      "destination": "https://cortexplus.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/subscription-renewal",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/study-reminders",
      "schedule": "0 16 * * *"
    }
  ]
}
